{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "igcs0478-analytics",
  "account_id": "f37c59dd27eda122bb8e32860d63de39",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
